# Kast CMS API connection
# Bare origin of the Kast API. All routes are served under /api/v1, which the
# app appends automatically — do NOT include /api/v1 here.
KAST_API_URL=http://localhost:3000

# Optional read-only delivery key (sent as X-Kast-Key). The public Delivery API
# works WITHOUT a key; supplying one raises the rate limit and bypasses CORS for
# trusted server-side rendering. Leave empty for purely public sites.
KAST_API_KEY=

# Default content locale requested from the Delivery API (/delivery/content/:type).
KAST_LOCALE=en

# Site metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_NAME=My Blog
NEXT_PUBLIC_SITE_DESCRIPTION=A blog powered by Kast CMS
