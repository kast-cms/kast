{
  "name": "kast",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @kast-cms/api run prisma:generate",
    "db:migrate": "dotenv -- pnpm --filter @kast-cms/api run prisma:migrate",
    "db:migrate:prod": "dotenv -- pnpm --filter @kast-cms/api run prisma:migrate:prod",
    "db:seed": "dotenv -- pnpm --filter @kast-cms/api run prisma:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "multi-semantic-release --deps.bump=override",
    "release:dry": "multi-semantic-release --dry-run --deps.bump=override",
    "release:bootstrap-tags": "node scripts/bootstrap-release-tags.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@commitlint/types": "^21.1.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "conventional-changelog-conventionalcommits": "^10.2.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.8",
    "multi-semantic-release": "^3.0.2",
    "prettier": "^3.9.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "semantic-release": "^25.0.5",
    "turbo": "^2.10.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1",
      "fast-uri": "^3.1.2",
      "fast-xml-builder": "^1.1.7",
      "form-data": "^4.0.6",
      "esbuild": "^0.28.1",
      "multer": "^2.2.0",
      "nodemailer": "^9.0.1",
      "undici": "^7.28.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
