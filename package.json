{
  "name": "kast",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @kast-cms/api run prisma:generate",
    "db:migrate": "dotenv -- pnpm --filter @kast-cms/api run prisma:migrate",
    "db:migrate:prod": "dotenv -- pnpm --filter @kast-cms/api run prisma:migrate:prod",
    "db:seed": "dotenv -- pnpm --filter @kast-cms/api run prisma:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "multi-semantic-release --deps.bump=override",
    "release:dry": "multi-semantic-release --dry-run --deps.bump=override",
    "release:bootstrap-tags": "node scripts/bootstrap-release-tags.mjs",
    "prepare": "husky",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "multi-semantic-release": "^3.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.1.0",
    "semantic-release": "^24.0.0",
    "turbo": "2.10.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "overrides": {
      "@babel/core": "^7.29.6",
      "@hono/node-server": "^2.0.5",
      "body-parser": "^2.3.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@>=4": "^5.0.9",
      "deepmerge-ts": "^8.0.0",
      "handlebars": "^4.7.10",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "next": "^16.3.8",
      "devalue": "^5.9.2",
      "dompurify": "^3.4.16",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.6",
      "fast-xml-builder": "^1.1.7",
      "form-data": "^4.0.6",
      "icu-minify": "^4.9.2",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "lodash": "^4.18.1",
      "multer": "^2.3.0",
      "nanoid": "^3.3.17",
      "next-intl": "^4.9.2",
      "nodemailer": "^10.0.9",
      "postcss": "^8.5.18",
      "qs": "^6.16.0",
      "sharp": "^0.35.5",
      "svgo": "^4.1.0",
      "undici": "^7.29.1",
      "uuid": "^11.1.1",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "smol-toml": "^1.9.0",
      "hono": "^4.13.5",
      "postcss-selector-parser@6": "^7.1.6"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
