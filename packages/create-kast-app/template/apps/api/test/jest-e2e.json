{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^isomorphic-dompurify$": "<rootDir>/stubs/isomorphic-dompurify.ts"
  },
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1,
  "forceExit": true,
  "collectCoverageFrom": ["../src/**/*.(t|j)s"],
  "coverageDirectory": "../coverage-e2e",
  "transformIgnorePatterns": [
    "/node_modules/(?!\\.pnpm/|otplib/|@otplib/|@noble/|@scure/|openid-client/|oauth4webapi/|jose/)"
  ]
}
