# ──────────────────────────────────────────
# Kast CMS API — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Application
# NODE_ENV is deliberately NOT set here. This file gets copied onto real servers
# and never revisited, so a value shipped in it would end up describing the wrong
# deployment — and several security guards read it. The API defaults to
# development; docker-compose forces production. Set NODE_ENV=production yourself
# if you run the API any other way (bare metal, systemd, a PaaS).
PORT=3000

# Database (PostgreSQL 16)
# Local dev (app on host): use localhost. Full-stack Docker: use host "postgres".
# Set POSTGRES_PASSWORD before running Compose, and put the same value in the
# host-side DATABASE_URL when running the API outside Docker.
POSTGRES_USER=kast
POSTGRES_PASSWORD=
POSTGRES_DB=kast_db
DATABASE_URL=postgresql://kast:CHANGE_ME@localhost:5432/kast_db

# Redis 7
# Local dev (app on host): use localhost. Full-stack Docker: set REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# The readiness probe fails when a queue crosses either threshold, so an
# orchestrator/monitor has an explicit backlog and retained-failure signal.
QUEUE_BACKLOG_ALERT_THRESHOLD=1000
QUEUE_FAILED_ALERT_THRESHOLD=100

# JWT (minimum 32-character secret)
JWT_SECRET=change_me_to_a_very_long_random_secret_min32
JWT_EXPIRES_IN=15m

# Encrypts secret settings (e.g. smtp.password) at rest. Minimum 32 chars.
# Falls back to JWT_SECRET when unset — if you then rotate JWT_SECRET, every
# stored secret setting becomes unreadable. Set this explicitly in production.
KAST_SECRET_ENCRYPTION_KEY=
# During rotation, put the retired key(s) here until saved SMTP, plugin and
# webhook secrets have been exercised and re-encrypted. Remove afterward.
KAST_SECRET_ENCRYPTION_PREVIOUS_KEYS=

# Webhook egress policy. Webhook targets that resolve to private, loopback,
# link-local or otherwise reserved addresses are rejected by default, as are
# non-http(s) schemes. List hosts here to allow them anyway (comma or space
# separated; "*.suffix" wildcards supported). Empty means default-deny.
WEBHOOK_ALLOWED_HOSTS=

# Plugins call back into the API over loopback. KAST_API_TOKEN is required for
# first-party plugins (Meilisearch indexing, Stripe product sync) to read
# entries — a READ_ONLY token is sufficient.
KAST_API_URL=http://127.0.0.1:3000
KAST_API_TOKEN=

# Local development logins. Uncommenting the line below lets `pnpm run db:seed`
# create admin@kast.local / Admin1234! and writer@kast.local / Writer1234!, and
# tells the API those publicly known passwords are intentional. Without it the
# seed refuses and the API refuses to start while such an account is live. Never
# set it on a host anyone else can reach.
# SEED_DEV_ACCOUNTS=i-know-these-credentials-are-public

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Express `trust proxy`. Governs req.ip, which is both the address recorded
# against a public form submission and the rate limiter's key. Keep 'false'
# unless a reverse proxy sits in front and overwrites X-Forwarded-For; then use
# the number of proxies ('1'), an IP/CIDR, or 'true'.
TRUST_PROXY=false

# Public base URL of the admin panel, INCLUDING its base path: the Next.js app
# is served under /admin, and the API mints OAuth-callback, password-reset and
# invite links from this value. Its bare origin is also what may frame the API,
# so the queue monitor works.
ADMIN_URL=http://localhost:3001/admin

# Storage provider: local | s3 | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/tmp/kast-uploads
# Public base URL for locally stored objects: the route this API actually
# serves. Override only when a proxy or CDN fronts STORAGE_LOCAL_DIR directly.
STORAGE_LOCAL_URL=http://localhost:3000/api/v1/media/files

# AWS S3 (only required when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Upload limits
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# ── OAuth sign-in ─────────────────────────────
# Public site origin. Distinct from ADMIN_URL in a split deployment.
SITE_URL=http://localhost:3000

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Whether an OAuth identity with no matching account may create one. Any
# provider will hand back an address for any inbox its own users control, so
# this is a self-registration policy, and it stays closed until opened.
#   disabled  (default) sign-in only; an unknown address is refused
#   allowlist provision when the email domain is listed below
#   open      provision any address the provider asserts
OAUTH_SIGNUP_MODE=disabled
OAUTH_SIGNUP_ALLOWED_DOMAINS=
# Require the provider to assert the address is verified. Set 'false' only for
# providers that omit the claim (GitHub).
OAUTH_SIGNUP_REQUIRE_VERIFIED=true
