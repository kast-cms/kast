# ──────────────────────────────────────────
# Kast CMS API — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Application
# NODE_ENV is deliberately NOT set here. This file gets copied onto real servers
# and never revisited, so a value shipped in it would end up describing the wrong
# deployment — and several security guards read it. The API defaults to
# development; docker-compose forces production. Set NODE_ENV=production yourself
# if you run the API any other way (bare metal, systemd, a PaaS).
PORT=3000

# Database (PostgreSQL 16)
# Local dev (app on host): use localhost. Full-stack Docker: use host "postgres".
DATABASE_URL=postgresql://kast:kast_secret@localhost:5432/kast_db

# Redis 7
# Local dev (app on host): use localhost. Full-stack Docker: set REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (minimum 32-character secret)
JWT_SECRET=change_me_to_a_very_long_random_secret_min32
JWT_EXPIRES_IN=15m

# Encrypts secret settings (e.g. smtp.password) at rest. Minimum 32 chars.
# Falls back to JWT_SECRET when unset — if you then rotate JWT_SECRET, every
# stored secret setting becomes unreadable. Set this explicitly in production.
KAST_SECRET_ENCRYPTION_KEY=

# Webhook egress policy. Webhook targets that resolve to private, loopback,
# link-local or otherwise reserved addresses are rejected by default, as are
# non-http(s) schemes. List hosts here to allow them anyway (comma or space
# separated; "*.suffix" wildcards supported). Empty means default-deny.
WEBHOOK_ALLOWED_HOSTS=

# Plugins call back into the API over loopback. KAST_API_TOKEN is required for
# first-party plugins (Meilisearch indexing, Stripe product sync) to read
# entries — a READ_ONLY token is sufficient.
KAST_API_URL=http://127.0.0.1:3000
KAST_API_TOKEN=

# Local development logins. Uncommenting the line below lets `pnpm run db:seed`
# create admin@kast.local / Admin1234! and writer@kast.local / Writer1234!, and
# tells the API those publicly known passwords are intentional. Without it the
# seed refuses and the API refuses to start while such an account is live. Never
# set it on a host anyone else can reach.
# SEED_DEV_ACCOUNTS=i-know-these-credentials-are-public

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Admin panel origin. Allowed to frame the API so the queue monitor works.
ADMIN_URL=http://localhost:3001

# Storage provider: local | s3 | r2 | gcs
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/tmp/kast-uploads
STORAGE_LOCAL_URL=http://localhost:3000/uploads

# AWS S3 (only required when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Upload limits
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
